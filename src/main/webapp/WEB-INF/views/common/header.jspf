<%--
  Khung giao diện chung: sidebar + tiêu đề trang.
  Trước khi include, trang set: pageTitle (tiêu đề), pageSection (dòng nhỏ phía trên), activeNav (mục menu đang chọn).
  Biến dùng chung sau khi include: ctx (context path), ico (đường dẫn sprite icon), me (user đang đăng nhập).
--%>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<c:set var="ico" value="${ctx}/assets/icons.svg"/>
<c:set var="me" value="${sessionScope.user}"/>
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><c:out value="${pageTitle}"/> · AIVES</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="${ctx}/assets/style.css">
</head>
<body>
<div class="app">
    <aside class="sidebar">
        <a class="brand" href="${ctx}/home" style="text-decoration:none">
            <span class="logo">AI</span>
            <span><b>AIVES</b><small>Adaptive Oral Examination</small></span>
        </a>
        <nav>
            <c:if test="${me.role == 'ADMIN'}">
                <div class="nav-group">Quản trị hệ thống</div>
                <a href="${ctx}/admin/users" class="${activeNav == 'users' ? 'active' : ''}"><svg class="icon"><use href="${ico}#i-users"/></svg>Tài khoản &amp; phân quyền</a>
                <a href="${ctx}/admin/subjects" class="${activeNav == 'subjects' ? 'active' : ''}"><svg class="icon"><use href="${ico}#i-book"/></svg>Môn học</a>
                <a href="${ctx}/admin/configs" class="${activeNav == 'configs' ? 'active' : ''}"><svg class="icon"><use href="${ico}#i-settings"/></svg>Cấu hình hệ thống</a>
            </c:if>
            <c:if test="${me.role == 'ADMIN' || me.role == 'LECTURER'}">
                <div class="nav-group">Ngân hàng câu hỏi</div>
                <a href="${ctx}/lecturer/questions" class="${activeNav == 'questions' ? 'active' : ''}"><svg class="icon"><use href="${ico}#i-library"/></svg>Câu hỏi &amp; rubric</a>
                <a href="${ctx}/lecturer/questions?action=generate" class="${activeNav == 'generate' ? 'active' : ''}"><svg class="icon"><use href="${ico}#i-sparkles"/></svg>AI sinh câu hỏi</a>
                <div class="nav-group">Vấn đáp</div>
                <a href="${ctx}/lecturer/sessions" class="${activeNav == 'sessions' ? 'active' : ''}"><svg class="icon"><use href="${ico}#i-message"/></svg>Lượt phỏng vấn</a>
            </c:if>
            <c:if test="${me.role == 'STUDENT'}">
                <div class="nav-group">Vấn đáp</div>
                <a href="${ctx}/student/interview" class="${activeNav == 'interview' ? 'active' : ''}"><svg class="icon"><use href="${ico}#i-mic"/></svg>Phỏng vấn AI</a>
            </c:if>
        </nav>
        <div class="user-card">
            <span class="avatar"><c:out value="${me.initials}"/></span>
            <span class="info"><b><c:out value="${me.fullName}"/></b><small><c:out value="${me.role.label}"/></small></span>
            <form method="post" action="${ctx}/logout">
                <button type="submit" title="Đăng xuất" aria-label="Đăng xuất"><svg class="icon"><use href="${ico}#i-logout"/></svg></button>
            </form>
        </div>
    </aside>

    <div class="main">
        <header class="page-header">
            <div>
                <div class="eyebrow"><c:out value="${pageSection}"/></div>
                <h1><c:out value="${pageTitle}"/></h1>
            </div>
        </header>
        <main class="content">
<c:if test="${not empty sessionScope.flashMessage}">
    <div class="alert ${sessionScope.flashType}">
        <svg class="icon"><use href="${ico}#${sessionScope.flashType == 'success' ? 'i-check-circle' : (sessionScope.flashType == 'error' ? 'i-alert' : 'i-info')}"/></svg>
        <span><c:out value="${sessionScope.flashMessage}"/></span>
    </div>
    <c:remove var="flashMessage" scope="session"/>
    <c:remove var="flashType" scope="session"/>
</c:if>
<c:if test="${not empty error}">
    <div class="alert error"><svg class="icon"><use href="${ico}#i-alert"/></svg><span><c:out value="${error}"/></span></div>
</c:if>
